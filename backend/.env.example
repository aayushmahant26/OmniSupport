# Groq API Configuration
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=""

# Recommended Groq models:
# - llama-3.3-70b-versatile (Highly accurate, fast)
# - llama-3.1-8b-instant (Ultra low latency)
GROQ_MODEL=llama-3.3-70b-versatile

# If GROQ_API_KEY is not set or unavailable, the backend automatically falls back
# to your local Ollama instance (http://localhost:11434) running model 'phi3:latest'.
